{
  "name": "create-minimalize-template",
  "version": "1.4.0",
  "type": "module",
  "description": "CLI to scaffold React + Vite + TypeScript + Tailwind v4 + React Router + Zustand projects",
  "keywords": [
    "vite",
    "react",
    "typescript",
    "tailwind",
    "tailwindcss",
    "react-router",
    "react-router-dom",
    "zustand",
    "template",
    "scaffold",
    "cli",
    "create-app"
  ],
  "author": "Tu Nombre <tu@email.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/minimalize-template-cli.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/minimalize-template-cli/issues"
  },
  "homepage": "https://github.com/yourusername/minimalize-template-cli#readme",
  "bin": {
    "create-minimalize-template": "cli.js"
  },
  "files": [
    "template/**/*",
    "cli.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node cli.js test-project-temp && rm -rf test-project-temp",
    "commit:hooks": "git config core.hooksPath .githooks",
    "commit:check": "git log -1 --format=%s > .git/COMMIT_EDITMSG && node scripts/validate-commit-msg.mjs .git/COMMIT_EDITMSG",
    "release:patch": "pnpm version patch && pnpm publish",
    "release:minor": "pnpm version minor && pnpm publish",
    "release:major": "pnpm version major && pnpm publish",
    "prepublishOnly": "node -e \"console.log('🔍 Validating template...'); const fs = require('fs'); if (!fs.existsSync('./template/package.json')) { console.error('❌ Template missing!'); process.exit(1); } console.log('✅ Template valid');\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "fs-extra": "^11.1.1"
  }
}
